{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        // Android dev builds must select a distribution flavor (`direct` here)
        // and pass APP_FLAVOR so the self-updater is wired; drop both `--flavor`
        // and APP_FLAVOR for an iOS run (the iOS scheme is not flavored).
        {
            "name": "openmaps",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file=.dart-define.json",
                "--dart-define=APP_FLAVOR=direct",
                "--flavor",
                "direct"
            ]
        },
        {
            "name": "openmaps (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file=.dart-define.json",
                "--dart-define=APP_FLAVOR=direct",
                "--flavor",
                "direct"
            ]
        },
        {
            "name": "openmaps (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=.dart-define.json",
                "--dart-define=APP_FLAVOR=direct",
                "--flavor",
                "direct"
            ]
        }
    ]
}