# Keep the build context small and, above all, keep secrets out of the image.
# The server reads its production config and secrets from the environment /
# mounted files at runtime (see openmaps_infra/docs/07-maps-api.md).

.git
.github
.dart_tool
**/.dart_tool
.serverpod
**/.serverpod
**/build
**/.packages
**/pubspec_overrides.yaml
**/.env
**/*.pem

# Local secrets - never baked into an image.
maps_api_server/config/passwords.yaml
maps_api_server/config/*firebase*
maps_api_server/config/*adminsdk*
